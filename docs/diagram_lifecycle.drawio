<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0" type="device">
  <diagram id="lifecycle-batik-kinanthi" name="Lifecycle Batik Kinanthi">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lbl0" value="Siklus hidup data Batik Kinanthi" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=34;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="30" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="lbl1" value="SUMBER DATA" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="-215" y="135" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="lbl2" value="LIMA TAHAP SIKLUS HIDUP DATA" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="488" y="135" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="lbl3" value="PENGGUNA" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1205" y="135" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="lbl4" value="ENAM UNDERCURRENTS: hadir di semua tahap" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="500" y="603" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="src1" value="&lt;b&gt;Toko&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;kasir toko fisik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=19;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="src2" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;toko online sendiri&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=19;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="src3" value="&lt;b&gt;Marketplace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;penjualan lewat marketplace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=19;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="st1" value="&lt;b&gt;1. Generation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Sistem sumber mencatat transaksi tiga kanal di PostgreSQL: pelanggan, produk, transaksi, detail_transaksi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="290" y="240" width="200" height="270" as="geometry"/></mxCell>
        <mxCell id="st2" value="&lt;b&gt;2. Ingestion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;ingest() mengambil data transaksi dari sumber ke pipeline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="514" y="240" width="200" height="270" as="geometry"/></mxCell>
        <mxCell id="st3" value="&lt;b&gt;3. Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;store_raw() menyimpan salinan mentah ke data/raw/transaksi.csv. Storage menopang semua tahap lain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="738" y="240" width="200" height="270" as="geometry"/></mxCell>
        <mxCell id="st4" value="&lt;b&gt;4. Transformation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;check_quality() menahan data rusak, lalu transform() menghitung omzet harian per kanal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="962" y="240" width="200" height="270" as="geometry"/></mxCell>
        <mxCell id="st5" value="&lt;b&gt;5. Serving&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;serve() menulis tabel siap pakai mart_omzet_harian&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1186" y="240" width="200" height="270" as="geometry"/></mxCell>
        <mxCell id="u1" value="&lt;b&gt;Pemilik usaha&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;membaca dashboard omzet harian per kanal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=19;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1440" y="180" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="u2" value="&lt;b&gt;Data Analyst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;laporan motif terlaris, analisis penurunan penjualan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=19;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1440" y="320" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="u3" value="&lt;b&gt;Data Scientist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;prediksi stok kain, rekomendasi produk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=19;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1440" y="460" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="un1" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;kredensial di file .env, tidak ditulis di kode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="un2" value="&lt;b&gt;Data management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;check_quality(): id ganda, total &amp;lt;= 0, kanal kosong&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="313" y="650" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="un3" value="&lt;b&gt;DataOps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;log di setiap tahap, pemeriksaan kualitas otomatis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="586" y="650" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="un4" value="&lt;b&gt;Data architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;sumber, data mentah (raw), dan mart dipisah&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="859" y="650" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="un5" value="&lt;b&gt;Orchestration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;main() menjalankan tahap berurutan, jadwal belum ada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1132" y="650" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="un6" value="&lt;b&gt;Software engineering&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;satu fungsi per tahap, docstring, type hint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=18;verticalAlign=top;align=center;spacingTop=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1405" y="650" width="255" height="120" as="geometry"/></mxCell>
